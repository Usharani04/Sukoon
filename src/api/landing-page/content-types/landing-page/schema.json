{
  "kind": "collectionType",
  "collectionName": "landing_pages",
  "info": {
    "singularName": "landing-page",
    "pluralName": "landing-pages",
    "displayName": "Landing Page",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "page_type": {
      "type": "enumeration",
      "enum": [
        "landing",
        "service",
        "about",
        "listing",
        "detail",
        "blog",
        "contact"
      ],
      "default": "landing"
    },
    "page_purpose": {
      "type": "text"
    },
    "target_audience": {
      "type": "string"
    },
    "primary_action": {
      "type": "string"
    },
    "content_owner": {
      "type": "string"
    },
    "reference_design_url": {
      "type": "string"
    },
    "approval_status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "ready_for_review",
        "approved"
      ],
      "default": "draft",
      "required": true
    },
    "last_reviewed_on": {
      "type": "date"
    },
    "breadcrumb_label": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "elements.seo"
    },
    "page_builder": {
      "type": "dynamiczone",
      "components": [
        "landing.hero",
        "landing.feature-cards",
        "landing.city-cards",
        "landing.concern-list",
        "landing.steps",
        "landing.expert-spotlight",
        "landing.image-gallery",
        "landing.process-stages",
        "landing.video-embed",
        "landing.video-list",
        "landing.testimonials",
        "landing.faq",
        "landing.cta-banner"
      ]
    }
  }
}
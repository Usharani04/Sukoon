{
  "kind": "collectionType",
  "collectionName": "doctors",
  "info": {
    "singularName": "doctor",
    "pluralName": "doctors",
    "displayName": "DOCTOR"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "qualifications": {
      "type": "string"
    },
    "role": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Psychiatrist",
        "Psychologist",
        "Occupational Therapist",
        "Art-Based Therapist",
        "PSW",
        "Clinical Advisory Board",
        "Clinical Leads",
        "Nursing"
      ]
    },
    "experience_years": {
      "type": "integer"
    },
    "bio": {
      "type": "text"
    }
  }
}
